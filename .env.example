# =====================================================================
# APP-INFORMES - MONOREPO ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Default: SQLite for turnkey execution; switch to PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL configuration:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/app_informes?schema=public"

# Authentication & Security
JWT_SECRET="app-informes-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="8h"
MAX_REGISTERED_USERS=5

# Mailer Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones.crr@arauco-informes.com"
SMTP_PASS="secret_password"
SMTP_FROM='"APP-Informes CRR" <notificaciones.crr@arauco-informes.com>'

# Client URL (for CORS and token verification links)
CLIENT_URL="http://localhost:5173"
VITE_API_URL="http://localhost:4000/api"
